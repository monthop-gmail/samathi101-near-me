/*
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: no-cache

/app.js
  Cache-Control: no-cache

/index.css
  Cache-Control: no-cache

# branches.json ถูกใช้อ้างอิงข้ามโปรเจกต์ จึงเปิด CORS ไว้ (Cloudflare Pages
# ใส่ access-control-allow-origin: * ให้อยู่แล้ว) และใช้ ETag ควบคุมความสด
/branches.json
  Cache-Control: no-cache

/config.json
  Cache-Control: no-cache
